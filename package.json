{
    "name": "@rio-cloud/iframe-resizer",
    "version": "1.0.0",
    "description": "Secure automatic iframe resizing for React hosts and modern browser clients",
    "homepage": "https://github.com/rio-cloud/iframe-resizer",
    "repository": {
        "type": "git",
        "url": "https://github.com/rio-cloud/iframe-resizer.git"
    },
    "license": "Apache-2.0",
    "type": "module",
    "module": "./dist/react/index.js",
    "types": "./dist/react/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./child": {
            "types": "./dist/child/index.d.ts",
            "import": "./dist/child/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "LICENSE",
        "MIGRATION.md",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": [
        "./dist/child/index.js"
    ],
    "scripts": {
        "build": "npm run clean && npm run build:types && npm run build:javascript",
        "build:javascript": "esbuild src/react/index.tsx src/child/index.ts --bundle --format=esm --platform=browser --target=es2022 --outdir=dist --outbase=src --external:react --external:react/jsx-runtime",
        "build:types": "tsc --project tsconfig.build.json",
        "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm pack --dry-run",
        "clean": "node tools/clean.mjs",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "prepack": "npm run build",
        "start": "vite --host 127.0.0.1 --open /demo/",
        "test:server": "vite --host 127.0.0.1",
        "test": "vitest run",
        "test:integration": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=10.0.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@playwright/test": "1.61.1",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "24.11.0",
        "@types/react": "18.3.28",
        "@types/react-dom": "18.3.7",
        "esbuild": "0.28.1",
        "happy-dom": "20.11.1",
        "iframe-resizer": "4.3.11",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "typescript": "7.0.2",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    }
}
